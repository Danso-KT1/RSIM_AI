    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
