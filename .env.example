# XAI_API_KEY: Required for xAI Grok Voice Transcribe 2.0 (Primary audio transcription engine)
# Powers institutional audio transcription with speaker diarization and timestamps.
# Get an API key at https://console.x.ai
XAI_API_KEY="xai-your-api-key-here"

# GEMINI_API_KEY: Required for Google Gemini calls (powers both Gemini 3.8 Flash and Gemini 2.5 Flash / Pro).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your-gemini-api-key-here"

# GROQ_API_KEY: Optional key for GroqCloud ultra-fast Llama 3.3 70B inference (Tier 2 auto-failover).
# Get a free key at https://console.groq.com
GROQ_API_KEY="gsk_your-groq-api-key-here"

# OPENROUTER_API_KEY: Optional key for OpenRouter multi-model gateway.
# One single key covers all OpenRouter models: GPT models (prioritized first), Perplexity Sonar, NVIDIA Nemotron (1M context), and MiniMax.
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# DEEPSEEK_API_KEY: Optional key for DeepSeek / Universal OpenAI-compatible inference (Tier 4 auto-failover).
# Get an API key at https://platform.deepseek.com
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"

# OPENAI_API_KEY: Optional direct OpenAI key (powers GPT-4o, GPT-4o-mini, o3-mini in Tier 3).
# Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HF_TOKEN: Token for Hugging Face Inference Providers (Serverless open-source models)
# Requires Fine-grained token with "Make calls to the Inference Providers" permission.
# Get an API token at https://huggingface.co/settings/tokens
HF_TOKEN="hf_your-huggingface-token-here"